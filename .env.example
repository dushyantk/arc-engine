# Postgres — shots, versions, approvals (docker-compose)
DATABASE_URL=postgresql://dailies:dailies@localhost:5451/dailies

# ClickHouse — continuity fingerprints, QC findings, agent decision log (docker-compose)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8124
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=dailies
CLICKHOUSE_SECURE=false

# MinIO — reference frames, generated video, VFX package exports (docker-compose)
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=dailies
MINIO_SECRET_KEY=dailies-dev-only
MINIO_BUCKET=dailies

# Gemini Developer API — planner (gemini-3.6-flash), critic (gemini-3.1-pro-preview),
# and Veo 3.1 generation all go through this one key. Verified 2026-08-17.
GEMINI_API_KEY=

# Set true only if MinIO is behind TLS. Local docker-compose is plain HTTP.
MINIO_SECURE=false

# Optional upgrade path (higher quota, org billing) — not needed for beta.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# FastAPI agent runtime, consumed by the Next.js app
AGENT_RUNTIME_URL=http://localhost:8091

# Optional spending ceiling across all runs, in USD. Unset means no cap is
# enforced - the runtime refuses a billed run that would take total logged
# spend past this, before the call is made.
DAILIES_BUDGET_USD=

# Signs the session cookie. Generate with: openssl rand -base64 32
# No default on purpose - a fallback secret makes every deployment forgeable.
BETTER_AUTH_SECRET=
# Public origin of the web app. Defaults to http://localhost:3210 for dev.
BETTER_AUTH_URL=

# Shared secret between the web app and the agent runtime. Unset means the
# runtime is open - fine locally, never for a deployment. Both sides need the
# same value. Generate with: openssl rand -hex 32
AGENT_RUNTIME_TOKEN=

# Extra origins allowed to post to the auth endpoints, comma-separated. Needed
# when the app is served on a hostname other than BETTER_AUTH_URL (a preview URL,
# or behind a proxy). Localhost dev and the 3211 test port are trusted
# automatically outside production.
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Cloudflare R2 (bucket arc-engine) — production object storage ----------
# Deliberately NOT reusing the MINIO_* names above: those still point at the
# local docker-compose MinIO, and overwriting them here would break local dev.
# R2 is S3-compatible, so deployment maps these onto the MINIO_* names the code
# already reads (lib/minio.ts, server/storage/minio_client.py). Renaming those
# to a neutral OBJECT_STORE_* is a worthwhile follow-up, not something to slip
# into a credential paste.
#
# Keys come from the R2 "dailies-token" API token, scoped to arc-engine only.
R2_ACCOUNT_ID=
# <account id>.r2.cloudflarestorage.com — host only, no scheme.
R2_ENDPOINT=
R2_BUCKET=arc-engine
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
