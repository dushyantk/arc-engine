{
  "name": "dailies",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev:web": "next dev --port 3210",
    "dev:api": "uv run --directory server uvicorn main:app --reload --port 8091",
    "dev": "concurrently -n web,api -c blue,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "build": "next build",
    "start": "next start --port 3210",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "ch:migrate": "uv run --directory server python clickhouse/migrate.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clickhouse/client": "^1.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "minio": "^8.0.7",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.4.0"
}
