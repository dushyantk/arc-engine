# The Fly build context is the repo root, because the runtime image copies
# server/. Without this it uploads 2.2 GB on every deploy - .next and
# node_modules alone are 1.9 GB of it, and none of it belongs in a Python image.
.git
.next
node_modules
server/.venv
server/__pycache__
**/__pycache__
generations
test-results
playwright-report
e2e/.auth
.vercel
deploy/secrets.local.env
.env
.env.*
!.env.example
